NODE_ENV=development

# HTTP server
PORT=3000
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loan_management
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false

# Authentication
# Long random secret (min. 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session length (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h

# File storage (client photos)
# local = files on this server's disk (development); r2 = Cloudflare R2 (production)
STORAGE_DRIVER=local
# How long a photo link stays valid, in seconds
SIGNED_URL_TTL_SECONDS=3600
# --- local driver ---
LOCAL_STORAGE_DIR=./storage
# Public URL of this API (used to build photo links)
PUBLIC_API_URL=http://localhost:3000
# --- r2 driver (Cloudflare dashboard > R2 > Manage API tokens) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Initial administrator (used only by the admin seed)
ADMIN_FULL_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
