NODE_ENV=development

# HTTP server
PORT=3000
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loan_management
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false

# Authentication
# Long random secret (min. 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session length (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h

# Initial administrator (used only by the admin seed)
ADMIN_FULL_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
